\ProvidesFile{americanlawreview-harvardjolt.def}
  [2026/08/29 v0.1 Harvard Journal of Law & Technology-inspired profile]

% This profile deliberately keeps article-specific wording out of the class.
% The manuscript supplies the journal line, short title, and year below.
\providecommand*\alrjournalname{Harvard Journal of Law \& Technology}
\providecommand*\alrjournalissue{Submission Draft}
\providecommand*\alrshorttitle{Article Short Title}
\providecommand*\alryear{2026}
\providecommand*\alrsubmissionlabel{}
\providecommand*\alrfinallabel{}
\providecommand*\alrgeometryoptions{left=2in,right=2in,top=1in,bottom=1in}
\providecommand*\alrfontsetup{\RequirePackage{ebgaramond}}
\providecommand*\alrjournalfont{\fontfamily{ptm}\itshape\setstretch{1}\fontsize{12}{14}\selectfont}
\providecommand*\alrheaderfont{\fontfamily{ptm}\itshape\setstretch{1}\fontsize{10}{12}\selectfont}
\providecommand*\alrtitlefont{\normalfont\bfseries\scshape\setstretch{1}\fontsize{14}{18}\selectfont}
\providecommand*\alrauthorfont{\normalfont\itshape\setstretch{1}\fontsize{12}{15}\selectfont}
\providecommand*\alraffiliationfont{\normalfont\itshape\setstretch{1}\fontsize{11}{14}\selectfont}
\providecommand*\alrsectionfont{\normalfont\bfseries\scshape\setstretch{1}\fontsize{12}{15.5}\selectfont}
\providecommand*\alrsubsectionfont{\normalfont\bfseries\scshape\setstretch{1}\fontsize{11}{14}\selectfont}
\providecommand*\alrsubsubsectionfont{\normalfont\itshape\setstretch{1}\fontsize{11}{14}\selectfont}
\providecommand*\alrabstractheadingfont{\normalfont\bfseries\scshape\setstretch{1}\fontsize{12}{15}\selectfont}
\providecommand*\alrabstractfont{\normalfont\itshape\setstretch{1}\fontsize{12}{13.6}\selectfont}
\providecommand*\alrtocfont{\normalfont\setstretch{1}\fontsize{9}{15}\selectfont}

\providecommand*\alrprofilelayout{%
  % The reference keeps a 4.5-inch text block on Letter paper, with a compact
  % law-review leading rather than submission-style double spacing.
  \setstretch{1.069}% 12pt article normalsize (14.5pt) -> about 15.5pt
  \setlength{\parindent}{0.25in}%
  \setlength{\parskip}{0pt}%
  \setlength{\headheight}{15pt}%
  % Put the running head in the sample's shallow top band while retaining the
  % generous 0.95in gap before continuation text begins.
  \setlength{\headsep}{64pt}%
  \addtolength{\topmargin}{-9pt}%
  \setlength{\footnotesep}{1.5pt}%
  \setlength{\skip\footins}{18pt}%
  \interfootnotelinepenalty=10000\relax

  % Running heads reproduce the sample's short-title recto and journal verso
  % convention while retaining manuscript-specific, truthful labels.
  \pagestyle{fancy}%
  \fancyhf{}%
  \fancyhead[LO]{{\alrheaderfont\alrshorttitle}}%
  \fancyhead[RO]{{\alrheaderfont\thepage\hspace{31pt}}}%
  \fancyhead[LE]{{\alrheaderfont\thepage\hspace{3.65em}\alrjournalname}}%
  \fancyhead[RE]{{\alrheaderfont[\alryear]}}%
  \renewcommand{\headrulewidth}{0pt}%

  % Do not call \setstretch from inside a size-switch command: enumitem probes
  % \footnotesize while it is defining its own size table, and that would make
  % \@currsize recurse.  Setting the multiplier first yields an exact 9/10.5pt
  % footnote without that recursion.
  \renewcommand\footnotesize{\def\baselinestretch{1}\@setfontsize\footnotesize{9}{10.5}\fontfamily{ptm}\selectfont}%
  \renewcommand\footnoterule{\kern-3pt\hrule\@width\textwidth\@height .6pt\kern 2.6pt}%
  \renewcommand\@makefnmark{\hbox{\@textsuperscript{\normalfont\setstretch{1}\fontsize{6}{7}\selectfont\@thefnmark}}}%
  \long\def\@makefntext##1{\noindent\@makefnmark\hspace{.35em}##1}%

  % Headings in the source are title case.  Small caps gives the same visual
  % hierarchy as the reference without changing the manuscript text itself.
  \renewcommand\@seccntformat[1]{\csname the##1\endcsname.\hspace{1.8em}}%
  \renewcommand\section{%
    \@startsection{section}{1}{\z@}%
      {2.2ex \@plus -1ex \@minus -.2ex}%
      {4ex \@plus .2ex}%
      {\alrsectionfont}}%
  \renewcommand\subsection{%
    \@startsection{subsection}{2}{.5em}%
      {-1.7ex \@plus -.8ex \@minus -.2ex}%
      {.8ex \@plus .15ex}%
      {\alrsubsectionfont}}%
  \renewcommand\subsubsection{%
    \@startsection{subsubsection}{3}{\z@}%
      {-1.5ex \@plus -.7ex \@minus -.2ex}%
      {.7ex \@plus .15ex}%
      {\alrsubsubsectionfont\centering}}%

  \renewenvironment{abstract}
    {\par\vspace{.8\baselineskip}%
     {\centering\alrabstractheadingfont Abstract\par}%
     \vspace{.15\baselineskip}%
     \begingroup\setlength{\parindent}{0pt}\alrabstractfont\noindent}
    {\par\endgroup\vspace{.7\baselineskip}}%

  \renewcommand{\contentsname}{Table of Contents}%
  \renewcommand\tableofcontents{%
    \clearpage
    \vspace*{-12pt}%
    {\centering\alrabstractheadingfont\MakeUppercase{\contentsname}\par}%
    \vspace{.85\baselineskip}%
    \begingroup
      \alrtocfont
      \@starttoc{toc}%
    \endgroup
    \clearpage
    % The reference begins its first text page below the running head rather
    % than immediately beneath it.
    \vspace*{-34pt}%
  }%
  \renewcommand*\l@section{\@dottedtocline{1}{0em}{3.2em}}%
  \renewcommand*\l@subsection{\@dottedtocline{2}{1.45em}{2.7em}}%
  \renewcommand*\l@subsubsection{\@dottedtocline{3}{3.9em}{3.0em}}%

  \renewcommand{\maketitle}{%
    \thispagestyle{empty}%
    \begingroup
      \setlength{\parindent}{0pt}%
      \vspace*{-1.44in}%
      \begin{center}
        {\alrjournalfont\alrjournalname\par}%
        {\alrjournalfont\alrjournalissue\par}%
        \vskip 3.2\baselineskip
        {\alrtitlefont \@title\par}%
        \vskip .9\baselineskip
        {\alrauthorfont \@author\alrauthornotemark\par}%
        \alrprintaffiliation
      \end{center}%
    \endgroup
    \alrprintauthornotes}%
}
